:root {
    --vpa-font-family: <%= font_family %>;
    --vpa-title-color: <%= title_color %>;
    --vpa-text-color: <%= text_color %>;
    --vpa-link-color: <%= link_color %>;
    --vpa-btn-color: <%= btn_color %>;
    --vpa-btn-color-hover: <%= btn_color_hover %>;
    --vpa-btn-bg: <%= btn_background %>;
    --vpa-btn-bg-hover: <%= btn_background_hover %>;
    --vpa-btn-brd-width: <%= btn_border_width %>;
    --vpa-btn-brd-color: <%= btn_border_color %>;
    --vpa-btn-brd-color-hover: <%= btn_border_color_hover %>;
    --vpa-btn-radius: <%= btn_border_radius %>;
    --vpa-trans: <%= transition_animation %>;
}
