<div class="vpa-container vpa-full">
    <div class="vpa-wrapper vpa-hidden vpa-slide" id="vpa-full-wrapper">
        <div class="vpa-close-zone" aria-hidden="true">
            <div class="vpa-close-el"></div>
        </div>
        <div class="container">
            <div class="vpa-content">
                {{ privacy_text.value|raw }}
            </div>
            <div class="vpa-actions">
                <button class="btn btn-primary" id="vpa-btn-yes">Разрешаю</button>
                <button class="btn btn-secondary" id="vpa-btn-no">Не разрешаю</button>
            </div>
        </div>
    </div>
</div>